<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · <%= appName %></title>
  <link rel="stylesheet" href="/styles.css">
  <script src="/app.js" defer></script>
</head>
<body>
<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="/"><span class="brand-mark">◆</span> <%= appName %></a>
    <nav class="nav">
      <a href="/" class="<%= path === '/' ? 'active' : '' %>">Browse</a>
      <a href="/verify" class="<%= path === '/verify' ? 'active' : '' %>">Verify</a>
      <% if (currentUser) { %>
        <a href="/listings/new" class="btn btn-small">Sell data</a>
        <a href="/dashboard" class="<%= path === '/dashboard' ? 'active' : '' %>">Dashboard</a>
        <form method="post" action="/logout" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="link-button" type="submit">Sign out</button>
        </form>
      <% } else { %>
        <a href="/login">Sign in</a>
        <a href="/register" class="btn btn-small">Start selling</a>
      <% } %>
    </nav>
  </div>
</header>
<main class="wrap">
<% if (flash) { %>
  <div class="flash flash-<%= flash.type %>" role="status"><%= flash.message %></div>
<% } %>
